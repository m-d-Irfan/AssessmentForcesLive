# AssessmentForces - Environment Variables Configuration

# Backend API Endpoint (Render deployed backend service)
NEXT_PUBLIC_API_URL=https://assessment-forces.onrender.com/api/v1

# Frontend Application Origin (Vercel deployed frontend)
NEXT_PUBLIC_APP_URL=https://assessment-forces-ai.vercel.app

# Stripe Public Key (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_assessmentforces

# Demo Resilience Mode (true = automatic fallback if backend service is cold starting or unreachable)
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true
