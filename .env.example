# AssessmentForces - Environment Variables Configuration

# Backend API Endpoint (Points to Assi-6 express service or deployed server)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Frontend Application Origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Public Key (Test Mode)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_assessmentforces

# Demo Resilience Mode (true = automatic fallback if backend service is unreachable)
NEXT_PUBLIC_ENABLE_MOCK_FALLBACK=true
